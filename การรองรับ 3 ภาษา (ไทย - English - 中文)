# 5. Language Switcher

## app/components/LanguageSwitcher.tsx

```tsx
import { useTranslation } from "react-i18next";

export function LanguageSwitcher() {

  const { i18n } =
    useTranslation();

  return (
    <div className="flex gap-2">

      <button
        onClick={() =>
          i18n.changeLanguage("th")
        }
      >
        ไทย
      </button>

      <button
        onClick={() =>
          i18n.changeLanguage("en")
        }
      >
        EN
      </button>

      <button
        onClick={() =>
          i18n.changeLanguage("zh")
        }
      >
        中文
      </button>

    </div>
  );
}
```

