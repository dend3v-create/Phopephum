{
  "name": "phopephum",
  "private": true,
  "version": "2.0.0",
  "description": "Phopephum — Living Wisdom Operating System",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:web": "turbo run dev --filter=@phopephum/web",
    "dev:mobile": "turbo run dev --filter=@phopephum/mobile",
    "deploy:web": "turbo run deploy --filter=@phopephum/web",
    "deploy:workers": "turbo run deploy --filter=@phopephum/workers-ai-proxy",
    "deploy": "bash deploy.sh"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infrastructure/workers/*"
  ],
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "@types/node": "^22"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1"
    },
    "peerDependencyRules": {
      "ignoreMissing": ["react-helmet-async"]
    }
  }
}
