{
  "name": "phopephum",
  "private": true,
  "version": "2.0.0",
  "description": "Phopephum — Living Wisdom Operating System",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:web": "turbo run dev --filter=@phopephum/web",
    "dev:mobile": "turbo run dev --filter=@phopephum/mobile",
    "deploy:web": "turbo run deploy --filter=@phopephum/web",
    "deploy:workers": "turbo run deploy --filter=@phopephum/workers-ai-proxy",
    "deploy": "bash deploy.sh",
    "ci:verify": "turbo run lint typecheck test",
    "ci:financial-gate": "tsx scripts/ci-gate-financial-regression.ts",
    "ci:partner-gate": "tsx scripts/test-phase7-2-partner-financial-integrity.ts",
    "ci:post-deploy": "tsx scripts/ci-post-deploy-verify.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infrastructure/workers/*"
  ],
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "tsx": "^4.23.13",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react-helmet-async"
      ]
    }
  }
}
